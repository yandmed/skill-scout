{
  "version": 1,
  "gaps": [
    { "id": "secret-leak-risk", "category": "security", "priority": "high", "title": "A .env file exists but is not ignored by git", "when": { "all": ["envFileNotIgnored"] }, "queries": ["secret scanning", "credential leak prevention"] },
    { "id": "no-secret-scanning", "category": "security", "priority": "medium", "title": "No secret scanning configured", "when": { "all": ["hasSourceCode"], "none": ["hasSecretScan"] }, "queries": ["secret scanning", "gitleaks"] },
    { "id": "no-security-review", "category": "security", "priority": "high", "title": "No security analysis (SAST) found", "when": { "all": ["hasSourceCode"], "none": ["hasSast"] }, "queries": ["security review", "owasp code audit", "vulnerability scanning"] },
    { "id": "auth-review", "category": "security", "priority": "high", "title": "The project handles authentication, which deserves a dedicated review", "when": { "all": ["hasAuth"] }, "queries": ["authentication security", "authorization review"] },
    { "id": "no-dependency-updates", "category": "security", "priority": "medium", "title": "No automated dependency updates", "when": { "all": ["hasDependencies"], "none": ["hasDependencyBot"] }, "queries": ["dependency audit", "dependency update"] },
    { "id": "no-security-policy", "category": "security", "priority": "low", "title": "No SECURITY.md", "when": { "all": ["hasSourceCode"], "none": ["hasSecurityPolicy"] }, "queries": ["security policy"] },
    { "id": "no-tests", "category": "testing", "priority": "high", "title": "No automated tests found", "when": { "all": ["hasSourceCode"], "none": ["hasTests"] }, "queries": ["test driven development", "unit testing"] },
    { "id": "no-e2e", "category": "testing", "priority": "medium", "title": "Frontend without end-to-end tests", "when": { "all": ["hasFrontend"], "none": ["hasE2E"] }, "queries": ["end to end testing", "playwright testing"] },
    { "id": "no-linter", "category": "code-quality", "priority": "medium", "title": "No linter configured", "when": { "all": ["hasSourceCode"], "none": ["hasLinter"] }, "queries": ["code review", "linting"] },
    { "id": "no-formatter", "category": "code-quality", "priority": "low", "title": "No code formatter configured", "when": { "all": ["hasSourceCode"], "none": ["hasFormatter"] }, "queries": ["code style formatting"] },
    { "id": "no-typecheck", "category": "code-quality", "priority": "medium", "title": "JavaScript without type checking", "when": { "all": ["usesJavascript"], "none": ["hasTypecheck"] }, "queries": ["typescript migration", "type safety"] },
    { "id": "code-review-workflow", "category": "code-quality", "priority": "medium", "title": "Improve code with structured review and refactoring", "when": { "all": ["hasSourceCode"] }, "queries": ["code review", "refactoring", "clean code"] },
    { "id": "no-ci", "category": "devops", "priority": "high", "title": "No CI pipeline", "when": { "all": ["hasSourceCode"], "none": ["hasCI"] }, "queries": ["ci cd automation", "github actions"] },
    { "id": "no-container", "category": "devops", "priority": "low", "title": "Backend without a container definition", "when": { "all": ["hasBackend"], "none": ["hasDocker"] }, "queries": ["docker best practices"] },
    { "id": "no-observability", "category": "devops", "priority": "medium", "title": "Backend without logging, metrics or tracing", "when": { "all": ["hasBackend"], "none": ["hasObservability"] }, "queries": ["observability logging", "opentelemetry"] },
    { "id": "iac-review", "category": "devops", "priority": "medium", "title": "Infrastructure as code deserves a dedicated review", "when": { "all": ["hasIaC"] }, "queries": ["terraform best practices", "infrastructure security"] },
    { "id": "no-readme", "category": "documentation", "priority": "medium", "title": "No README", "when": { "all": ["hasSourceCode"], "none": ["hasReadme"] }, "queries": ["documentation writing", "readme"] },
    { "id": "no-claude-md", "category": "ai-workflow", "priority": "medium", "title": "No CLAUDE.md to give Claude project context", "when": { "none": ["hasClaudeMd"], "all": ["hasSourceCode"] }, "queries": ["claude md context", "project memory"] },
    { "id": "ai-app", "category": "ai-workflow", "priority": "medium", "title": "The project calls LLM APIs: evaluation and prompt quality matter", "when": { "all": ["usesLlmSdk"] }, "queries": ["llm evaluation", "prompt engineering", "prompt injection defense"] },
    { "id": "database-care", "category": "data", "priority": "medium", "title": "Database in use: schema, migrations and queries deserve attention", "when": { "all": ["hasDatabase"] }, "queries": ["database schema design", "sql query optimization", "database migrations"] },
    { "id": "frontend-quality", "category": "frontend", "priority": "medium", "title": "Frontend: accessibility and UI quality", "when": { "all": ["hasFrontend"] }, "queries": ["web accessibility", "frontend design"] },
    { "id": "web-performance", "category": "performance", "priority": "low", "title": "Frontend performance", "when": { "all": ["hasFrontend"] }, "queries": ["web performance core web vitals"] },
    { "id": "api-design", "category": "architecture", "priority": "low", "title": "API design and contracts", "when": { "all": ["hasApi"] }, "queries": ["api design", "openapi"] },
    { "id": "greenfield", "category": "architecture", "priority": "high", "title": "New project: plan before building", "when": { "all": ["isEmpty"] }, "queries": ["project planning", "software architecture", "spec driven development"] },
    { "id": "innovation-agents", "category": "innovation", "priority": "low", "title": "New ways of working: agent workflows and automation", "when": { "any": ["hasSourceCode", "isEmpty"] }, "queries": ["agent workflow automation", "subagent orchestration", "brainstorming"] }
  ],
  "technologies": {
    "nextjs": { "label": "Next.js", "deps": ["next"], "terms": ["next.js", "nextjs"], "kind": "frontend" },
    "react": { "label": "React", "deps": ["react"], "terms": ["react"], "kind": "frontend" },
    "react-native": { "label": "React Native", "deps": ["react-native", "expo"], "terms": ["react native", "react-native", "expo"], "kind": "mobile" },
    "vue": { "label": "Vue", "deps": ["vue", "nuxt"], "terms": ["vue", "nuxt"], "kind": "frontend" },
    "angular": { "label": "Angular", "deps": ["@angular/core"], "terms": ["angular"], "kind": "frontend" },
    "svelte": { "label": "Svelte", "deps": ["svelte"], "terms": ["svelte", "sveltekit"], "kind": "frontend" },
    "tailwind": { "label": "Tailwind CSS", "deps": ["tailwindcss"], "terms": ["tailwind"], "kind": "frontend" },
    "express": { "label": "Express", "deps": ["express"], "terms": ["express.js", "expressjs"], "kind": "backend" },
    "nestjs": { "label": "NestJS", "deps": ["@nestjs/core"], "terms": ["nestjs"], "kind": "backend" },
    "fastify": { "label": "Fastify", "deps": ["fastify"], "terms": ["fastify"], "kind": "backend" },
    "django": { "label": "Django", "deps": ["django"], "terms": ["django"], "kind": "backend" },
    "flask": { "label": "Flask", "deps": ["flask"], "terms": ["flask"], "kind": "backend" },
    "fastapi": { "label": "FastAPI", "deps": ["fastapi"], "terms": ["fastapi"], "kind": "backend" },
    "rails": { "label": "Ruby on Rails", "deps": ["rails"], "terms": ["rails"], "kind": "backend" },
    "laravel": { "label": "Laravel", "deps": ["laravel/framework"], "terms": ["laravel"], "kind": "backend" },
    "spring": { "label": "Spring", "deps": ["spring-boot"], "terms": ["spring boot", "springboot"], "kind": "backend" },
    "dotnet": { "label": ".NET", "deps": [], "terms": [".net", "asp.net", "c#", "dotnet"], "kind": "backend" },
    "flutter": { "label": "Flutter", "deps": ["flutter"], "terms": ["flutter"], "kind": "mobile" },
    "prisma": { "label": "Prisma", "deps": ["prisma", "@prisma/client"], "terms": ["prisma"], "kind": "database" },
    "drizzle": { "label": "Drizzle", "deps": ["drizzle-orm"], "terms": ["drizzle"], "kind": "database" },
    "postgres": { "label": "PostgreSQL", "deps": ["pg", "psycopg2", "psycopg2-binary", "psycopg", "asyncpg", "postgres"], "terms": ["postgres", "postgresql"], "kind": "database" },
    "mysql": { "label": "MySQL", "deps": ["mysql", "mysql2", "pymysql"], "terms": ["mysql"], "kind": "database" },
    "mongodb": { "label": "MongoDB", "deps": ["mongodb", "mongoose", "pymongo"], "terms": ["mongodb", "mongoose"], "kind": "database" },
    "redis": { "label": "Redis", "deps": ["redis", "ioredis"], "terms": ["redis"], "kind": "database" },
    "sqlalchemy": { "label": "SQLAlchemy", "deps": ["sqlalchemy"], "terms": ["sqlalchemy"], "kind": "database" },
    "firebase": { "label": "Firebase", "deps": ["firebase", "firebase-admin"], "terms": ["firebase", "firestore"], "kind": "backend" },
    "supabase": { "label": "Supabase", "deps": ["@supabase/supabase-js", "supabase"], "terms": ["supabase"], "kind": "backend" },
    "stripe": { "label": "Stripe", "deps": ["stripe"], "terms": ["stripe"], "kind": "service" },
    "better-auth": { "label": "Better Auth", "deps": ["better-auth"], "terms": ["better auth", "better-auth"], "kind": "service" },
    "aws": { "label": "AWS", "deps": ["aws-sdk", "boto3", "aws-cdk-lib"], "terms": ["aws", "lambda", "cloudformation"], "kind": "cloud" },
    "azure": { "label": "Azure", "deps": ["@azure/identity", "azure-identity"], "terms": ["azure"], "kind": "cloud" },
    "gcp": { "label": "Google Cloud", "deps": ["@google-cloud/storage", "google-cloud-storage"], "terms": ["gcp", "google cloud", "bigquery"], "kind": "cloud" },
    "terraform": { "label": "Terraform", "deps": [], "terms": ["terraform"], "kind": "infra" },
    "kubernetes": { "label": "Kubernetes", "deps": [], "terms": ["kubernetes", "k8s", "helm"], "kind": "infra" },
    "docker": { "label": "Docker", "deps": [], "terms": ["docker", "dockerfile"], "kind": "infra" },
    "salesforce": { "label": "Salesforce", "deps": [], "terms": ["salesforce", "apex"], "kind": "service" },
    "shopify": { "label": "Shopify", "deps": ["@shopify/shopify-api"], "terms": ["shopify"], "kind": "service" },
    "android": { "label": "Android", "deps": [], "terms": ["android", "jetpack compose"], "kind": "mobile" },
    "ios": { "label": "iOS", "deps": [], "terms": ["swiftui", "ios", "xcode"], "kind": "mobile" },
    "unity": { "label": "Unity", "deps": [], "terms": ["unity3d", "unity"], "kind": "other" }
  }
}
